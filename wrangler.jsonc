{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tangokuningatar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Every deployed version would otherwise get its own preview URL. One public endpoint is enough.
  "preview_urls": false,
  // Persist console output in Workers Logs (dashboard), not just `wrangler tail`.
  "observability": {
    "enabled": true
  },
  "vars": {
    // Our Telegram group. If the group is ever upgraded to a supergroup, its ID changes
    // (to a -100… number) and the Worker logs a "chat_migrated" warning with the new value.
    "ALLOWED_CHAT_ID": "-5465433776",
    // GIF for the daily shame: a Telegram file_id or an https URL. Empty = caption only.
    "SHAME_GIF": ""
  },
  // Cron runs on UTC, so each job is scheduled for both summer and winter time and
  // only the run at the right Finnish time does anything. src/index.ts tells them apart.
  // - The weekly crowning, Fridays at 16:00 in Finland: 13:00 or 14:00 UTC (src/crowning.ts).
  // - The daily shame for missed results, every day at 10:00 in Finland: 07:00 or 08:00 UTC (src/daily-shame.ts).
  "triggers": {
    "crons": ["0 13 * * fri", "0 14 * * fri", "0 7,8 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tangokuningatar",
      "database_id": "452d1793-da3c-4393-acee-72ad4b560b9c",
      // Applied by CI before every deploy (`npm run db:migrate:remote`).
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    // Uploaded from GitHub secrets on deploy; locally read from .dev.vars.
    "required": ["WEBHOOK_SECRET", "TELEGRAM_BOT_TOKEN"]
  }
}
