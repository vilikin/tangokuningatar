# Copy to .dev.vars for local development. .dev.vars is gitignored.

# Any value works locally; send the same value in the
# X-Telegram-Bot-Api-Secret-Token header when curling `npm run dev`.
# This is NOT the production secret, which lives only in GitHub.
WEBHOOK_SECRET=local-dev-secret

# Only used by `npm run webhook:info` / `npm run webhook:delete`.
# `npm run dev` always runs without a bot token (it only logs the reactions
# and replies it would send), so curling fixtures never posts to the group.
TELEGRAM_BOT_TOKEN=
